// Opposing forces. AtB/MekHQ generate the enemy as a force
// of its own — lances off the enemy house's RAT at a rolled skill level —
// not as a mirror of yours. Typed against domain/opfor.zig `Table`.
//
//   lances_min/max  lances the enemy brings to a typical engagement,
//                   balanced against a starter company (~14k BV, three
//                   line lances and a recon lance): a raid meets a bit
//                   less than you bring, an assault more. It does not
//                   shrink as your company wears down.
//   quality_mod     added to the 2d6 enemy-quality roll: front-line
//                   formations on assaults, second-line on garrison worlds
//
// Quality (AtB enemy skill table): 2d6 + mods ≤ green_max green, ≤
// regular_max regular, ≤ veteran_max veteran, else elite; pirates roll
// with pirate_quality_mod. The pool a contract grinds down is the force
// times its reinforcements over the months (reinforcement_bp_per_month,
// capped at reinforcement_months_cap months).
.{
    .by_kind = .{
        .{ .kind = "garrison_duty", .lances_min = 1, .lances_max = 2, .quality_mod = -1 },
        .{ .kind = "cadre_duty", .lances_min = 1, .lances_max = 2, .quality_mod = -1 },
        .{ .kind = "security_duty", .lances_min = 2, .lances_max = 3, .quality_mod = 0 },
        .{ .kind = "riot_duty", .lances_min = 2, .lances_max = 3, .quality_mod = -1 },
        .{ .kind = "planetary_assault", .lances_min = 4, .lances_max = 5, .quality_mod = 1 },
        .{ .kind = "relief_duty", .lances_min = 3, .lances_max = 4, .quality_mod = 1 },
        .{ .kind = "guerrilla_warfare", .lances_min = 2, .lances_max = 4, .quality_mod = 0 },
        .{ .kind = "pirate_hunting", .lances_min = 2, .lances_max = 3, .quality_mod = 0 },
        .{ .kind = "diversionary_raid", .lances_min = 2, .lances_max = 4, .quality_mod = 0 },
        .{ .kind = "objective_raid", .lances_min = 2, .lances_max = 4, .quality_mod = 0 },
        .{ .kind = "recon_raid", .lances_min = 2, .lances_max = 3, .quality_mod = 0 },
        .{ .kind = "extraction_raid", .lances_min = 2, .lances_max = 4, .quality_mod = 0 },
    },
    .lance_size = 4,
    .pirate_quality_mod = -2,
    .green_max = 5,
    .regular_max = 9,
    .veteran_max = 11,
    .reinforcement_bp_per_month = 5_000,
    .reinforcement_months_cap = 6,
}
