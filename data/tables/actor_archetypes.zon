// Actor archetypes. Each row names a kind of contract-introduced NPC the
// outfit may encounter; the archetype governs which arcs it may attach to
// and what side of the conflict it stands on.
// Typed against domain/actor.zig `Table`.
//
//   key           stable identifier (markup-safe)
//   name          display label (markup-safe)
//   kind          ActorKind tag name
//   agenda        short description of the actor's goals (markup-safe)
//   faction_side  which side: "employer" or "enemy"
//   arcs          arc keys this archetype attaches to
//
// All string fields must be markup-safe (no { or control characters).
.{
    .archetypes = .{
        .{
            .key = "liaison",
            .name = "Liaison Officer",
            .kind = "liaison",
            .agenda = "Coordinate employer objectives",
            .faction_side = "employer",
            .arcs = .{"fracturing_garrison"},
        },
        .{
            .key = "local_official",
