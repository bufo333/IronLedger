{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean *)",
      "Bash(sed *)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/projects/**/memory/**)"
    ],
    "ask": [
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git commit *)",
      "Bash(git merge --ff-only *)",
      "Bash(git branch -d *)"
    ],
    "allow": [
      "Edit(/CLAUDE.md)",
      "Edit(/ARCHITECTURE.md)",
      "Edit(/TODO.md)",
      "Edit(/src/**)",
      "Edit(/docs/**)",
      "Edit(/data/**)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Bash(zig build *)",
      "Bash(zig fmt *)",
      "Bash(docs/verify-contract.sh)",
      "Bash(bash docs/verify-contract.sh)",
      "Bash(python3 docs/tui_smoke.py *)",
      "Bash(bash docs/repl_smoke.sh *)",
      "Bash(docs/clean-package.sh)",
      "Bash(bash docs/clean-package.sh)",
      "Bash(python3 docs/data-fixtures.py)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git checkout main)",
      "Bash(git switch main)"
    ]
  }
}
